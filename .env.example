# ---- LLM (Ollama) -----------------------------------------------------------
# Any model pulled into Ollama; change it here and restart, nothing is hard-coded.
#
# You can also switch models from the UI at any time; the choice is remembered in
# data/selected_model.txt and overrides this value.
#
# Recommended for a live interview (measured on an Apple M5, see the README):
#   qwen3.5:4b            best answers by a wide margin, same speed as the 3B  (default)
#   qwen2.5:3b-instruct   fastest and shortest, weaker on modern architecture
#   qwen2.5:7b-instruct   solid, but writes twice as much
#
# Always-on reasoning models (qwen3:8b, qwen3:4b, deepseek-r1) work but are a poor
# fit: they think for 10-30s before the first word. The backend detects them and
# keeps their reasoning out of the answer, and warns you in the UI.
MODEL=qwen3.5:4b
OLLAMA_HOST=http://localhost:11434
LLM_TEMPERATURE=0.3
MAX_ANSWER_TOKENS=220
LLM_NUM_CTX=4096
LLM_TIMEOUT_S=60
LLM_KEEP_ALIVE=30m
# auto | true | false. "auto" probes the model once at startup. Modern hybrids
# (qwen3.5) genuinely honour thinking:false and answer immediately, so it is left
# off. Always-on reasoners (qwen3, deepseek-r1) ignore the switch and would spill
# their reasoning into the answer, so for those it is turned ON, which makes Ollama
# return the reasoning separately and keeps the answer clean.
LLM_THINK=auto
# Extra token budget for a reasoning model's chain-of-thought, on top of MAX_ANSWER_TOKENS.
LLM_THINKING_BUDGET=2000
LLM_WARMUP=true

# ---- Speech-to-text (faster-whisper) ---------------------------------------
# tiny | base | small | medium | large-v3 | distil-large-v3 ... (small is a good balance)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# "en" is fastest; use "auto" for language detection.
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=0

# ---- How a question is captured ---------------------------------------------
# push = hold a key (Tab) while the interviewer asks; only that audio becomes the
#        question and everything else is discarded. Nothing has to guess where a
#        question ended, so a pause mid-question cannot split it.
# auto = the older behaviour: silence of VAD_SILENCE_MS is treated as the end of
#        a question. Convenient, but a thinking pause can split one question in two.
CAPTURE_MODE=push
# Safety cap: if the key is somehow held forever, answer what we have.
PUSH_MAX_S=180
# Taps shorter than this are ignored rather than sent to the model.
PUSH_MIN_S=0.4

# ---- Voice activity detection / segmentation --------------------------------
VAD_THRESHOLD=0.5
# Silence (ms) that marks the end of a question.
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=300
VAD_PREROLL_MS=320
MAX_UTTERANCE_S=30
# How often (s) to emit a partial transcript while the interviewer is still speaking.
PARTIAL_INTERVAL_S=1.2

# ---- Question detection & memory -------------------------------------------
MIN_QUESTION_WORDS=4
QUESTION_HOLD_S=1.5
HISTORY_TURNS=3
MAX_CONTEXT_CHARS=6000

# ---- Server -----------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=*
# Used by the Next.js frontend to reach the backend (http:// or https://).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---- Candidate context files -------------------------------------------------
PROFILE_PATH=config/candidate_profile.yaml
RESUME_PATH=data/resume.txt
